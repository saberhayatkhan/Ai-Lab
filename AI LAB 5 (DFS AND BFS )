        "}\n",
        "\n",
        "\n",
        "def ucs(graph, start, goal):\n",
        "frontier = [(0, start, [start])] # (path cost, node, path) explored = set()\n",
        "expanded = 0 while frontier:\n",
        "cost, node, path = heapq.heappop(frontier) # lowest g(n) first if node in explored:\n",
