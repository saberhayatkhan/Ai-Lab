        "if node == goal:\n",
        "return path, cost, expanded for nb, w in graph[node].items():\n",
        "if nb not in explored:\n",
        "heapq.heappush(frontier, (cost + w, nb, path + [nb])) return None, float('inf'), expanded\n",
        "\n",
