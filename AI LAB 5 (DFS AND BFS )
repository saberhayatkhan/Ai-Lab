        "from collections import deque import heapq\n",
        "\n",
        "# ---------- Grid maze: S = start, G = goal, # = wall ----------MAZE = [\"S\t# #\",\n",
        "\"# # . # # . .\",\n",
        "\". . . # . . #\",\n",
        "\". #\t#\",\n",
        "\"\t# . G\"]\n",
        "\n",
        "grid = [row.split() for row in MAZE] ROWS, COLS = len(grid), len(grid[0])\n",
        "\n",
        "def find(ch):\n",
        "for r in range(ROWS): for c in range(COLS):\n",
        "if grid[r][c] == ch: return (r, c)\n",
        "\n",
        "\n",
        "def neighbours(cell): r, c = cell\n",
        "for dr, dc in [(-1, 0), (0, 1), (1, 0), (0, -1)]: # Up, Right, Down, Left nr, nc = r + dr, c + dc\n",
        "if 0 <= nr < ROWS and 0 <= nc < COLS and grid[nr][nc] != '#': yield (nr, nc)\n",
        "\n",
        "def bfs(start, goal): frontier = deque([start]) parent = {start: None} expanded = 0\n",
        "\n",
        "while frontier:\n",
        "node = frontier.popleft() # FIFO queue expanded += 1\n",
        "if node == goal:\n",
        "return build_path(parent, goal), expanded for nb in neighbours(node):\n",
        "if nb not in parent: parent[nb] = node frontier.append(nb)\n",
        "return None, expanded\n",
        "\n",
        "\n",
        "def dfs(start, goal): frontier = [start] parent = {start: None} expanded = 0\n",
        "visited = set() while frontier:\n",
        "node = frontier.pop() # LIFO stack if node in visited:\n",
        "continue visited.add(node) expanded += 1\n",
        "if node == goal:\n",
        "return build_path(parent, goal), expanded for nb in neighbours(node):\n",
        "if nb not in visited: parent[nb] = node frontier.append(nb)\n",
        "return None, expanded\n",
        "\n",
        "def build_path(parent, node): path = []\n",
        "while node is not None: path.append(node) node = parent[node]\n",
        "return path[::-1]\n",
        "\n",
        "\n",
        "S, G = find('S'), find('G')\n",
        "print(f\"{'Algorithm':<6}{'Path length':>13}{'Nodes expanded':>17}\") for name, algo in [('BFS', bfs), ('DFS', dfs)]:\n",
