        "from collections import deque\n",
        "\n",
        "MAZE = [\n",
        "    \"S . . . . # #\",\n",
        "    \"# # . # # . .\",\n",
        "    \". . . # . . #\",\n",
        "    \". # . . . . #\",\n",
        "    \". . . . # . G\"\n",
        "]\n",
        "\n",
        "grid = [row.split() for row in MAZE]\n",
        "ROWS, COLS = len(grid), len(grid[0])\n",
        "\n",
        "def find(ch):\n",
        "    for r in range(ROWS):\n",
        "        for c in range(COLS):\n",
        "            if grid[r][c] == ch:\n",
        "                return (r, c)\n",
        "\n",
        "def neighbours(cell):\n",
        "    r, c = cell\n",
        "    for dr, dc in [(-1, 0), (0, 1), (1, 0), (0, -1)]:\n",
        "        nr, nc = r + dr, c + dc\n",
        "        if 0 <= nr < ROWS and 0 <= nc < COLS and grid[nr][nc] != '#':\n",
        "            yield (nr, nc)\n",
        "\n",
        "def build_path(parent, node):\n",
        "    path = []\n",
        "    while node is not None:\n",
        "        path.append(node)\n",
        "        node = parent[node]\n",
        "    return path[::-1]\n",
        "\n",
        "def bfs(start, goal):\n",
        "    frontier = deque([start])\n",
        "    parent = {start: None}\n",
        "    expanded = 0\n",
        "    max_frontier = 1\n",
        "\n",
        "    while frontier:\n",
        "        node = frontier.popleft()\n",
        "        expanded += 1\n",
        "\n",
        "        if node == goal:\n",
        "            return build_path(parent, goal), expanded, max_frontier\n",
        "\n",
        "        for nb in neighbours(node):\n",
        "            if nb not in parent:\n",
        "                parent[nb] = node\n",
        "                frontier.append(nb)\n",
        "\n",
        "        max_frontier = max(max_frontier, len(frontier))\n",
        "\n",
        "    return None, expanded, max_frontier\n",
        "\n",
        "def dfs(start, goal):\n",
        "    frontier = [start]\n",
        "    parent = {start: None}\n",
        "    expanded = 0\n",
        "    visited = set()\n",
        "    max_frontier = 1\n",
        "\n",
        "    while frontier:\n",
        "        node = frontier.pop()\n",
        "\n",
        "        if node in visited:\n",
        "            continue\n",
        "\n",
        "        visited.add(node)\n",
        "        expanded += 1\n",
        "\n",
        "        if node == goal:\n",
        "            return build_path(parent, goal), expanded, max_frontier\n",
        "\n",
        "        for nb in neighbours(node):\n",
        "            if nb not in visited:\n",
        "                parent[nb] = node\n",
        "                frontier.append(nb)\n",
        "\n",
        "        max_frontier = max(max_frontier, len(frontier))\n",
        "\n",
        "    return None, expanded, max_frontier\n",
        "\n",
        "S, G = find('S'), find('G')\n",
        "\n",
        "print(f\"{'Algorithm':<10}{'Path length':>13}{'Nodes expanded':>17}{'Max frontier':>15}\")\n",
        "\n",
        "for name, algo in [('BFS', bfs), ('DFS', dfs)]:\n",
        "    path, exp, mf = algo(S, G)\n",
        "    print(f\"{name:<10}{len(path)-1:>13}{exp:>17}{mf:>15}\")"
